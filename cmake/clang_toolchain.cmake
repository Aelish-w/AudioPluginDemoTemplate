include_guard(GLOBAL)

find_program(AUDIO_PLUGIN_DEMO_CLANG NAMES clang clang-22 REQUIRED)
find_program(AUDIO_PLUGIN_DEMO_CLANGXX NAMES clang++ clang++-22 REQUIRED)
find_program(AUDIO_PLUGIN_DEMO_LLD NAMES ld.lld ld.lld-22 REQUIRED)
find_program(AUDIO_PLUGIN_DEMO_LLVM_AR NAMES llvm-ar llvm-ar-22 REQUIRED)
find_program(AUDIO_PLUGIN_DEMO_LLVM_NM NAMES llvm-nm llvm-nm-22 REQUIRED)
find_program(AUDIO_PLUGIN_DEMO_LLVM_OBJCOPY NAMES llvm-objcopy llvm-objcopy-22 REQUIRED)
find_program(AUDIO_PLUGIN_DEMO_LLVM_RANLIB NAMES llvm-ranlib llvm-ranlib-22 REQUIRED)
find_program(AUDIO_PLUGIN_DEMO_LLVM_STRIP NAMES llvm-strip llvm-strip-22 REQUIRED)

set(CMAKE_C_COMPILER "${AUDIO_PLUGIN_DEMO_CLANG}" CACHE FILEPATH "Clang C compiler" FORCE)
set(CMAKE_CXX_COMPILER "${AUDIO_PLUGIN_DEMO_CLANGXX}" CACHE FILEPATH "Clang C++ compiler" FORCE)
set(CMAKE_LINKER "${AUDIO_PLUGIN_DEMO_LLD}" CACHE FILEPATH "LLVM linker" FORCE)
set(CMAKE_AR "${AUDIO_PLUGIN_DEMO_LLVM_AR}" CACHE FILEPATH "LLVM archiver" FORCE)
set(CMAKE_NM "${AUDIO_PLUGIN_DEMO_LLVM_NM}" CACHE FILEPATH "LLVM symbol dumper" FORCE)
set(CMAKE_OBJCOPY "${AUDIO_PLUGIN_DEMO_LLVM_OBJCOPY}" CACHE FILEPATH "LLVM object copier" FORCE)
set(CMAKE_RANLIB "${AUDIO_PLUGIN_DEMO_LLVM_RANLIB}" CACHE FILEPATH "LLVM archive indexer" FORCE)
set(CMAKE_STRIP "${AUDIO_PLUGIN_DEMO_LLVM_STRIP}" CACHE FILEPATH "LLVM symbol stripper" FORCE)

string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " -fuse-ld=lld")
string(APPEND CMAKE_MODULE_LINKER_FLAGS_INIT " -fuse-ld=lld")
string(APPEND CMAKE_SHARED_LINKER_FLAGS_INIT " -fuse-ld=lld")
