{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "clang",
      "displayName": "Clang development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/clang",
      "toolchainFile": "${sourceDir}/cmake/clang_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "AUDIO_PLUGIN_DEMO_ENABLE_CLANG_TOOLS": "ON",
        "AUDIO_PLUGIN_DEMO_ENABLE_SANITIZERS": "ON",
        "AUDIO_PLUGIN_DEMO_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang release",
      "inherits": "clang",
      "binaryDir": "${sourceDir}/out/build/clang-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AUDIO_PLUGIN_DEMO_ENABLE_SANITIZERS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang",
      "configurePreset": "clang"
    },
    {
      "name": "clang-checks",
      "configurePreset": "clang",
      "targets": [
        "clang-checks"
      ]
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release"
    }
  ],
  "testPresets": [
    {
      "name": "clang",
      "configurePreset": "clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
